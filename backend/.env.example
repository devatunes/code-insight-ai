# Puerto HTTP del backend
PORT=3000

# Proveedor de IA activo: claude | openai | gemini | ollama
# Solo "claude" está implementado — el resto son adapters stub.
AI_PROVIDER=claude

# Requerida solo si AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# DynamoDB
ANALYSES_TABLE_NAME=code-insight-analyses
AWS_REGION=us-east-1
# Solo para desarrollo local con DynamoDB Local (docker-compose) — dejar
# vacío en producción para que el SDK use el endpoint regional real.
DYNAMO_ENDPOINT=http://localhost:8000
